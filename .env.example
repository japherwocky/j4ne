# OpenCode Configuration
# Get your API key from: https://opencode.ai/auth
OPENCODE_ZEN_API_KEY=your_opencode_zen_api_key_here

# OpenCode Go is the default plan. Zen's free models (big-pickle) refuse
# callers outside OpenCode itself, and Go answers only requests that carry a
# User-Agent and an x-opencode-session, which j4ne sends.
# See: https://opencode.ai/docs/go/
# OPENCODE_USE_GO=true

# The model for each question, and for the rounds after a tool call (by
# default the same model). These two name the model on either plan, Go
# included. On Go the default is glm-5.3, and j4ne uses the chat-completions
# endpoint, which serves the GLM, Kimi and DeepSeek models. Current list:
# https://opencode.ai/inference/go/v1/models
# OPENCODE_ZEN_MODEL=glm-5.3
# OPENCODE_ZEN_FOLLOWUP_MODEL=glm-5.3-flash

# Zen instead of Go: set OPENCODE_USE_GO=false and pick Zen models
# (defaults gpt-5.1-codex and gpt-5.1-codex-mini). https://opencode.ai/docs/zen/

# Completion token limit per call; reasoning models spend part of it thinking
# OPENCODE_MAX_TOKENS=3000

# Rounds of tool calls one question may make before it has to answer
# J4NE_MAX_TOOL_ROUNDS=10

# Web server address. nginx proxies to 127.0.0.1:8000 in production.
# J4NE_HOST=127.0.0.1
# J4NE_PORT=8000

# IRC Configuration
# Off unless IRC_SERVER is set. Anyone in the channels can talk to the bot,
# so IRC gets the public tools only (web search, GitHub), like Slack.
# IRC_SERVER=irc.libera.chat
# IRC_PORT=6667
# IRC_NICKNAME=j4ne-bot
# IRC_REALNAME=J4NE Chat Bot
# IRC_CHANNELS=#j4ne-test
# IRC_COMMAND_PREFIX=!
# IRC_PASSWORD=your_nickserv_password_here

# Slack Configuration
# Get these from your Slack app at https://api.slack.com/apps
# Docs: https://docs.slack.dev/apis/events-api/

SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Socket Mode (Development):
# - Requires SLACK_APP_TOKEN for WebSocket connection
# - Works behind firewall without public endpoint
# - Easier for local development
# Get app token from: Slack App > Settings > Socket Mode
# SLACK_APP_TOKEN=xapp-your-app-token-here

# HTTP Mode (Production - Recommended):
# - Requires SLACK_SIGNING_SECRET for request verification
# - Requires public HTTPS endpoint (nginx reverse proxy handles this)
# - More scalable and reliable for production
# Get signing secret from: Slack App > Settings > Basic Information > App credentials
# SLACK_SIGNING_SECRET=your-signing-secret-here

# Connection mode: "socket" (development), "http" (production), or "auto" (default)
# Auto-detect: uses HTTP if SLACK_SIGNING_SECRET is set, otherwise Socket Mode
# SLACK_MODE=auto

# Web Search Configuration (for Slack Bot Tools)
# Serper API provides Google Search results for Slack users
# - Free tier: 2,500 searches/month
# - Paid: $50/month for 100,000 searches
# - Get API key from: https://serper.dev/
# - Alternative: Use SEARCH_API_KEY instead of SERPER_API_KEY
# SERPER_API_KEY=your_serper_api_key_here
# SEARCH_API_KEY=your_search_api_key_here

# GitHub API Configuration (for Slack Bot Tools)
# Optional: Provides higher rate limits for GitHub API calls
# - Free tier: 60 requests/hour unauthenticated
# - Authenticated: 5,000 requests/hour
# - Create Personal Access Token at: https://github.com/settings/tokens
# - Select 'public_repo' scope for public repository access
# GITHUB_TOKEN=ghp_your_github_token_here

# Memory & Context Configuration
CONTEXT_WINDOW_TOKENS=4000
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Proactive Agent Configuration
# Interval in seconds between proactive agent runs (0 to disable)
# Default: 0 (disabled)
PROACTIVE_INTERVAL_SECONDS=0

# Channel to send proactive messages to (e.g., "#general", "#alerts")
# Use SLACK_GUARDIAN_USER for direct messages instead
PROACTIVE_CHANNEL=#general

# Guardian Slack user ID to receive direct messages (e.g., "U123456789")
# The guardian is the primary contact who can be pinged directly
# SLACK_GUARDIAN_USER=U123456789
